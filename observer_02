import java.util.ArrayList;
import java.util.Scanner;

// Observer
interface Observer {
    void update(String message);
}

// Concrete Observer
class Subscriber implements Observer {

    String name;

    Subscriber(String name) {
        this.name = name;
    }

    public void update(String message) {
        System.out.println(name + " received notification: " + message);
    }
}

// Subject
class YouTubeChannel {

    ArrayList<Subscriber> subscribers = new ArrayList<>();

    // Subscribe
    public void subscribe(Subscriber s) {
        subscribers.add(s);
        System.out.println(s.name + " subscribed.");
    }

    // Unsubscribe
    public void unsubscribe(Subscriber s) {
        subscribers.remove(s);
        System.out.println(s.name + " unsubscribed.");
    }

    // Notify
    public void uploadVideo(String title) {
        System.out.println("\nNew Video Uploaded: " + title);

        for (Subscriber s : subscribers) {
            s.update(title);
        }
    }
}

// Main
public class Main {

    public static void main(String[] args) {

        Scanner sc = new Scanner(System.in);

        YouTubeChannel channel = new YouTubeChannel();

        while (true) {

            System.out.println("\n1. Subscribe");
            System.out.println("2. Unsubscribe");
            System.out.println("3. Upload Video");
            System.out.println("4. Exit");

            System.out.print("Enter Choice: ");
            int choice = sc.nextInt();
            sc.nextLine();

            switch (choice) {

                case 1:

                    System.out.print("Enter Subscriber Name: ");
                    String name = sc.nextLine();

                    Subscriber s = new Subscriber(name);
                    channel.subscribe(s);

                    break;

                case 2:

                    System.out.print("Enter Subscriber Name: ");
                    String removeName = sc.nextLine();

                    Subscriber removeSubscriber = null;

                    for (Subscriber sub : channel.subscribers) {
                        if (sub.name.equalsIgnoreCase(removeName)) {
                            removeSubscriber = sub;
                            break;
                        }
                    }

                    if (removeSubscriber != null) {
                        channel.unsubscribe(removeSubscriber);
                    } else {
                        System.out.println("Subscriber not found.");
                    }

                    break;

                case 3:

                    System.out.print("Enter Video Title: ");
                    String title = sc.nextLine();

                    channel.uploadVideo(title);

                    break;

                case 4:

                    System.out.println("Program End.");
                    sc.close();
                    return;

                default:

                    System.out.println("Invalid Choice.");
            }
        }
    }
}
