import java.util.Scanner;


interface Computer {

    void config();
}


class Lab1Computer implements Computer {

    @Override
    public void config() {

        System.out.println("Processor: Core i5-10400");
        System.out.println("RAM: 8GB 3200GHz");
        System.out.println("Hard disk: 1 TB HDD");
        System.out.println("Monitor: 18 inch HD");
    }
}

class Lab2Computer implements Computer {

    @Override
    public void config() {

        System.out.println("Processor: Core i5-11400");
        System.out.println("RAM: 8GB 3600GHz");
        System.out.println("Hard disk: 1 TB HDD");
        System.out.println("Monitor: 21 inch FHD");
    }
}


class Lab3Computer implements Computer {

    @Override
    public void config() {

        System.out.println("Processor: Core i7-10700");
        System.out.println("RAM: 8GB 2800GHz");
        System.out.println("Hard disk: 512 GB HDD + 256 SSD");
        System.out.println("Monitor: 22 inch FHD");
    }
}

class Lab4Computer implements Computer {

    @Override
    public void config() {

        System.out.println("Processor: Core i7-11700");
        System.out.println("RAM: 8GB 3600GHz");
        System.out.println("Hard disk: 1 TB HDD + 256 GB SSD");
        System.out.println("Monitor: 24 inch FHD");
    }
}


class ComputerFactory {

    public static Computer getComputer(String lab) {

        if (lab.equalsIgnoreCase("Lab-1")) {

            return new Lab1Computer();

        } else if (lab.equalsIgnoreCase("Lab-2")) {

            return new Lab2Computer();

        } else if (lab.equalsIgnoreCase("Lab-3")) {

            return new Lab3Computer();

        } else if (lab.equalsIgnoreCase("Lab-4")) {

            return new Lab4Computer();

        } else {

            return null;
        }
    }
}

class Main {

    public static void main(String[] args) {

        Scanner sc = new Scanner(System.in);

        System.out.println("Available Labs:");
        System.out.println("1. Lab-1");
        System.out.println("2. Lab-2");
        System.out.println("3. Lab-3");
        System.out.println("4. Lab-4");

        System.out.print("Enter lab name: ");

        String lab = sc.nextLine();
        Computer computer = ComputerFactory.getComputer(lab);
        computer.config();

}
        

   
}
